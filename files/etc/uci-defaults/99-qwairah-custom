#!/bin/sh
uci set system.@system[0].hostname='QWAIRAH'
uci set system.@system[0].zonename='Asia/Aden'
uci set system.@system[0].timezone='AST-3'
uci commit system

uci set luci.main.lang='ar'
uci set luci.main.mediaurlbase='/luci-static/bootstrap'
uci commit luci

uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci commit dhcp

uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci set dropbear.@dropbear[0].Port='22'
uci commit dropbear

sed -i 's/^root:[^:]*:/root::/' /etc/passwd
sed -i 's/^root:/QWAIRAH:/' /etc/passwd

uci set wireless.radio0.disabled='0'
uci set wireless.radio0.channel='6'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.country='00'
uci set wireless.radio0.txpower='35'

uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid='QWAIRAH 2G'
uci set wireless.default_radio0.encryption='none'

uci set wireless.radio1.disabled='0'
uci set wireless.radio1.channel='36'
uci set wireless.radio1.htmode='VHT40'
uci set wireless.radio1.country='00'
uci set wireless.radio1.txpower='35'

uci set wireless.default_radio1.device='radio1'
uci set wireless.default_radio1.network='lan'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.ssid='QWAIRAH 5G'
uci set wireless.default_radio1.encryption='none'
uci commit wireless

echo "0 */6 * * * sync && echo 3 > /proc/sys/vm/drop_caches" >> /etc/crontabs/root
mkdir -p /etc/config
touch /etc/config/qwairah
/usr/bin/qwairah-telegram.sh "تم تشغيل المودم وإقلاع النظام بنجاح" &
exit 0
